system: preload_file user://underground.mp3
system: assign hina:1
system: assign mondo:2
system: assign kyoko:3
system: assign sakura:4
system: assign kiyotaka:6
system: assign hifumi:9
system: assign toko:10
system: assign leon:11
system: assign celeste:12
system: assign chihiro:13
system: assign byakuya:14
system: assign yasuhiro:15
system: assign makoto:8
camera: focus_on makoto
system: set_mouse_color blue
makoto: say await=true [color=#49aec5]Kyoko said it was a "bewildering act"...[/color]
system: set_mouse_color yellow
system: set_mouse_color blue
makoto: say await=true [color=#49aec5]I almost didn't notice it at first, but... is that the key point here?[/color]
system: set_mouse_color yellow
camera: set_narrator_view true
system: set_mouse_color green
narrator: say await=false [color=green]There's[color=yellow] a bit more to learn [/color]about Nonstop Debates. Would you like to hear more?[/color]
system: wait 0.2s
system: choose Not_at_all! Absolutely!
system: ifanswer Absolutely!
system: set_mouse_color green
narrator: say await=true [color=green]Thank you![/color]
system: set_mouse_color green
narrator: say await=true [color=green]Thank you for choosing yes![/color]
system: set_mouse_color green
narrator: say await=true [color=green]You're my guy bro![/color]
system: set_mouse_color green
narrator: say await=true [color=green]Here comes another question btw[/color]
system: set_mouse_color green
narrator: say await=false [color=green]Are you over 18?[/color]
system: choose Yes hell_nah_bro
system: ifanswer Yes
system: set_mouse_color green
narrator: say await=true [color=green]oh, cool![/color]
system: set_mouse_color green
narrator: say await=true [color=green]one last questionn[/color]
system: choose leave_me_alone i_hate_you i_love_you
system: ifanswer leave me alone
system: set_mouse_color green
narrator: say await=true [color=green]sorry oke[/color]
system: else
system: set_mouse_color green
narrator: say await=true [color=green]i know[/color]
system: endif
system: else
system: set_mouse_color green
narrator: say await=true [color=green]get the hell outta here ma boy[/color]
system: endif
system: else
system: set_mouse_color green
narrator: say await=true [color=green]Ow, really?[/color]
system: set_mouse_color green
narrator: say await=true [color=green]Grrr[/color]
system: set_mouse_color green
narrator: say await=true [color=green]I hate you[/color]
system: endif
system: set_mouse_color green
narrator: say await=true [color=green]This is after the if[/color]
camera: focus_on makoto
camera: set_narrator_view false