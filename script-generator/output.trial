system: preload_file user://underground.mp3
system: assign hina:1
system: assign mondo:2
system: assign kyoko:3
system: assign sakura:4
system: assign kiyotaka:6
system: assign hifumi:9
system: assign toko:10
system: assign leon:11
system: assign celeste:12
system: assign chihiro:13
system: assign byakuya:14
system: assign yasuhiro:15
system: assign makoto:8
camera: focus_on makoto
system: set_mouse_color green
narrator: say [color=green]What do you think? Will you do it?[/color]
system: set_mouse_color yellow
system: ask Yes No
system: ifanswer Yes
system: set_mouse_color green
narrator: say [color=green]Thank you![/color]
system: set_mouse_color yellow
system: else
system: set_mouse_color green
narrator: say [color=green]Ow, really?[/color]
system: set_mouse_color yellow
system: endif