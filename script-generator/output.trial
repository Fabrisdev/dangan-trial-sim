system: preload_file user://underground.mp3
system: assign hina:1
system: assign mondo:2
system: assign kyoko:3
system: assign sakura:4
system: assign kiyotaka:6
system: assign hifumi:9
system: assign toko:10
system: assign leon:11
system: assign celeste:12
system: assign chihiro:13
system: assign byakuya:14
system: assign yasuhiro:15
system: assign makoto:8
camera: focus_on makoto
makoto: expression hmm
system: set_mouse_color blue
makoto: say await=true [color=#49aec5]Kyoko said it was a "bewildering act"...[/color]
system: set_mouse_color yellow
system: set_mouse_color blue
makoto: say await=true [color=#49aec5]I almost didn't notice it at first, but... is that the key point here?[/color]
system: set_mouse_color yellow
camera: set_narrator_view true
system: set_mouse_color green
narrator: say await=false [color=green]There's[color=yellow] a bit more to learn [/color]about Nonstop Debates. Would you like to hear more?[/color]
system: wait 0.2s
system: choose Not_at_all! Absolutely!
system: ifanswer Absolutely!
system: show_ui false
system: set_mouse_color green
narrator: say await=true [color=green]From here on out, the number of weak spots will start going up.[/color]
system: set_mouse_color green
narrator: say await=true [color=green]But no matter how many weak spots, there's essentially only one[color=yellow] lie or contradiction [/color]in that debate.[/color]
system: set_mouse_color green
narrator: say await=true [color=green]What I'm trying to say is, not all weak spots you see are necessarily false.[/color]
system: set_mouse_color green
narrator: say await=true [color=green]Use a Truth Bullet on the wrong one, and not only will you fail to refute what they said...[/color]
system: set_mouse_color green
narrator: say await=true [color=green]But you'll also lower your trust with everyone, and[color=yellow] your Influence Gauge will take damage[/color].[/color]
system: set_mouse_color green
narrator: say await=true [color=green]Now this is important, because if your Influence Gauge reaches zero, you[color=yellow] fail[/color].[/color]
system: set_mouse_color green
narrator: say await=true [color=green]You'll have to rely on your own[color=yellow] logic [/color]to determine which weak spots are actually [color=yellow]lies or contradictions[/color].[/color]
system: set_mouse_color green
narrator: say await=true [color=green]Well then...good luck, and have fun![/color]
system: endif
camera: focus_on makoto
camera: set_narrator_view false
system: set_mouse_color blue
makoto: say await=true [color=#49aec5]welp lets start it[/color]
system: set_mouse_color yellow